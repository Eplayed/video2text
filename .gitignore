# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# 本地配置（包含 Cookie/API Key）
config/config.env
config/config.env.local
# 换 key/换 cookie 时手动留的备份，内容和上面那份一样是凭据，别让它顺着 git add 溜进库
config/config.env.local.bak*
# 用户自己收编的海报模板：是运行数据，换机时手动迁移，不入库
config/poster_templates.json
config/poster_templates/

# 生成的索引数据
*.json
# 术语纠正表是人工维护的项目知识（不是生成物），必须入库才能跨机共享
!config/term_glossary.json

# 魔兽实名写法对照表：和上面那张同性质——人工维护的配置，不是运行数据也不是素材成品，
# 里面只有游戏内条目名，没有密钥、账号与收益数字，公开仓库里可以放
!config/wow_aliases.json
# 索引原子写入产生的本地备份（仅本地安全副本，非代码/数据，勿入库）
*.json.bak

# 日志
logs/
*.log

# 临时文件
temp/

# macOS
.DS_Store

# IDE
.vscode/
.idea/
*.swp

# Excel 文件（用户数据）
*.xlsx

# 输出文档和素材
output/
*.docx
*.mp4
*.wav

# 第三方解析器（含本地cookie与嵌套git，仅本地保留）
vendor/

# 空库名误生成的废文件（sheet 名被当成 db 路径，8/27 留下）
抖音视频数据

# 本地回收站（仅本地备份，勿入库）
.trash/

# 微头条试跑的交付 PNG 属可再生产物（同目录 .html + render.py 可重出），勿入库
微头条试跑/**/*.png
# 例外：工作台原型的演示图是 index.html 硬依赖且不可再生，需入库
!微头条试跑/头条图文工作台原型/assets/*.png

# 要卖的资料成品与原料不进公开仓库（GitHub 上是 PUBLIC，推上去等于免费公开）
product/

# 角色 skill 里有账号名、粉丝/收益实测数字、合规口径，仓库是 PUBLIC，只留本机
.qoder/skills/media-*
